# ---- Kinesis Money API (read-only use) ----
# Generate at: https://kms.kinesis.money/settings/api-keys
KINESIS_PUBLIC_KEY=your_kinesis_public_key
KINESIS_PRIVATE_KEY=your_kinesis_private_key
KINESIS_BASE_URL=https://client-api.kinesis.money

# ---- Monarch Money (unofficial API) ----
MONARCH_EMAIL=you@example.com
MONARCH_PASSWORD=your_monarch_password
# Optional: the TOTP/MFA *secret* (not a 6-digit code) shown when you set up
# authenticator-app MFA in Monarch. Lets the sync run unattended. Leave blank
# if you don't use MFA; you'll be prompted for a one-time code at login.
MONARCH_MFA_SECRET=
# Monarch API host. The monarchmoney library defaults to the OLD, now-throttled
# api.monarchmoney.com (returns HTTP 429); the API moved to api.monarch.com.
MONARCH_BASE_URL=https://api.monarch.com

# ---- Valuation / behavior ----
# Display currency label (informational).
BASE_FIAT=USD
# Quote leg Kinesis prices against. Kinesis uses C1USD (its USD-pegged unit),
# NOT plain USD — pairs look like KAU_C1USD. Leave as C1USD unless you know better.
KINESIS_QUOTE=C1USD
# OHLC candle size used to pull historical prices. 1440 (daily) is confirmed
# working against the live API. Candles are resampled to one price per day.
OHLC_TIMEFRAME=1440

# Symbols to track by default (comma-separated). Empty = the two metals
# (KAU, KAG). Set e.g. KAU,KAG,KVT to also track Kinesis Velocity Token.
# A CLI --symbols flag always overrides this.
SYMBOLS=KAU,KAG,KVT
